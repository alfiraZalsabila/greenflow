# Salin menjadi .env lalu isi nilainya. Jangan commit berkas .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Origin frontend (untuk pemeriksaan Origin/CSRF pada Phase 1)
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE_DAYS=7

# Firebase — wajib diisi pada Phase 1
FIREBASE_PROJECT_ID=irigasisawi-a28c1
FIREBASE_WEB_API_KEY=

# Saat memakai emulator (dev/test)
FIREBASE_USE_EMULATOR=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Admin pertama (hanya untuk npm run seed:admin)
ADMIN_SEED_EMAIL=admin@greenflow.local
ADMIN_SEED_PASSWORD=

# Produksi: pilih salah satu
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
